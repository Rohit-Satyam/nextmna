manifest {
    name            = 'Watzlowik-et-al-2023-MNase-Seq-Nextflow'
    author          = 'Converted from the Watzlowik et al. 2023 Snakemake workflow'
    description     = 'Paired-end MNase-seq preprocessing, mononucleosome filtering, DANPOS3 and Nucleosome Dynamics analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '>=26.04.0'
}

params {
    input           = "/home/subudhak/data/di_mnaseq/Watzlowik_et_al_2023/nextmna/samplesheet.csv"
    reference       = "/home/subudhak/data/di_mnaseq/Watzlowik_et_al_2023/nextmna/resources/PlasmoDB-68_Pfalciparum3D7_Genome.fasta"
    annotation      = "/home/subudhak/data/di_mnaseq/Watzlowik_et_al_2023/nextmna/resources/PlasmoDB-68_Pfalciparum3D7.gff"
    danpos_comparison = "iKO_24hr:noKO_24hr"
    outdir          = 'results'

    rnd_seed        = 0
    fastp_extra = '--correction --disable_quality_filtering --disable_length_filtering --disable_trim_poly_g'
    bowtie2_extra   = '--very-sensitive --no-discordant --no-mixed --no-unal'

    min_fragment_length = 75
    max_fragment_length = 175
    min_mapping_quality = 20
    sam_flag_include    = 2

    samtools_sort_memory = '1G'
    qualimap_java_mem    = '4G'

    danpos_extra = '-m 1 -c 51137214 --extend 73 -a 1 -z 20 -jd 100 -e 1'

    adjust_fdr_n_simulations      = null
    adjust_fdr_sampling_occupancy = 'near'
    adjust_fdr_sampling_fuzziness = 'near'


    // Nucleosome Dynamics settings. Conditions must match the samplesheet exactly.
    nucdyn_comparison           = 'iKO_24hr:noKO_24hr'
    nucdyn_contrast_name        = '24h'
    nucdyn_annotation           = '/home/subudhak/data/di_mnaseq/Watzlowik_et_al_2023/MNase-Seq/0_data/reference/pf_nucDyn.gff'
    nucdyn_fragment_length      = 175
    nucdyn_threshold_percentage = 50
    nucdyn_expected_replicates  = 2
    nucdyn_container            = 'nucleosomedynamics_docker_readr2'
    nucdyn_launcher             = '/home/NucleosomeDynamics/runNuclDyn'
}

process {
    executor = 'local'
    shell = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in [137, 143] ? 'retry' : 'terminate' }
    maxRetries = 1

    withLabel: process_low {
        cpus = 2
        memory = '4 GB'
        time = '4h'

    }
    withLabel: process_medium {
        cpus = 8
        memory = '16 GB'
        time = '12h'

    }
    withLabel: process_high {
        cpus = 12
        memory = '32 GB'
        time = '24h'

    }
    withLabel: process_danpos {
        cpus = 8
        memory = '48 GB'
        time = '72h'

    }
    withLabel: process_adjust_fdr {
        cpus = 4
        memory = '32 GB'
        time = '72h'

    }
    withLabel: process_nucdyn {
        cpus = 8
        //memory = '24 GB'
        time = '24h'
}

withName: NUCDYN_READ_BAM {
    cpus = 8

    // Attempt 1: 24 GB RAM
    // Attempt 2: 48 GB RAM
    //memory = { 24.GB * task.attempt }

    time = 24.h
    maxForks = 1

    /*
     * Nextflow adds Docker's --memory limit from task.memory.
     * Permit this container to additionally use host swap.
     */
    containerOptions = '--entrypoint "" -u $(id -u):$(id -g) --memory-swap=-1 --memory-swappiness=100'

    errorStrategy = {
        task.exitStatus in 137..140 ? 'retry' : 'terminate'
    }

    maxRetries = 1
}

    withLabel: process_nucdyn_compare {
        cpus = 8
        memory = '48 GB'
        time = '72h'

    }
}

profiles {
    standard {
        conda.enabled = true
        conda.useMamba = true
        docker.enabled = true
    }
    conda {
        conda.enabled = true
        conda.useMamba = true
        docker.enabled = true
    }
    slurm {
        process.executor = 'slurm'
        conda.enabled = true
        conda.useMamba = true
        // Requires Docker on every allocated compute node.
        docker.enabled = true
    }
}

conda.cacheDir = "${baseDir}/work/conda"

dag {
    enabled = true
    file = "${params.outdir}/pipeline_dag.html"
      overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_trace.txt"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_report.html"
    overwrite = true
}
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_timeline.html"
    overwrite = true
}
